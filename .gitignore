# Scratch work-aids (plans/reviews/specs) — never committed per project convention
_review/
.planning/
docs/superpowers/

# tsc output must never land in source directories. A build run with a
# mis-set rootDir emits .js/.js.map/.d.ts next to the .ts sources, and a
# `git add -A` then commits them (happened once — 24 files).
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
# R-267 / R-282: .d.ts.map was missing from this list, so eight declaration
# maps were tracked under packages/runar-compiler/src/ — the exact accident the
# comment above describes, caught a second time by the audit rather than by the
# ignore rule.
packages/*/src/**/*.d.ts.map
