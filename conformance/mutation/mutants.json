      "class": "swapped operands",
      "stage": "peephole",
      "expectCaughtBy": ["peephole-exhaustive"]
    },
    {
      "id": "peephole-numequal-to-not-corrupt",
      "file": "packages/runar-compiler/src/optimizer/peephole-rules.ts",
      "find": "replacement: [opc('OP_NOT')],",
      "replace": "replacement: [opc('OP_0NOTEQUAL')],",
      "class": "swapped operands",
      "stage": "peephole",
      "expectCaughtBy": ["peephole-exhaustive"]
    },
    {
      "id": "peephole-rot-to-swap",
      "file": "packages/runar-compiler/src/optimizer/peephole-rules.ts",
      "find": "replacement: [{ op: 'rot' }],",
      "replace": "replacement: [{ op: 'swap' }],",
      "class": "off-by-one stack index",
      "stage": "peephole",
      "expectCaughtBy": ["peephole-exhaustive"]
    },
    {
      "id": "peephole-pick1-over-to-dup",
      "file": "packages/runar-compiler/src/optimizer/peephole-rules.ts",
      "find": "replacement: [{ op: 'over' }],",
      "replace": "replacement: [{ op: 'dup' }],",
      "class": "off-by-one stack index",
      "stage": "peephole",
      "expectCaughtBy": ["peephole-exhaustive"]
    },
    {
      "id": "constantfold-add-to-sub",
      "file": "packages/runar-compiler/src/optimizer/constant-fold.ts",
      "find": "case '+': return left + right;",
      "replace": "case '+': return left - right;",
      "class": "swapped operands",
      "stage": "constant-fold",
      "expectCaughtBy": ["fold-execution"],
      "checkGates": ["differential-witness", "fold-equivalence", "fold-execution"],
      "finding": "Previously a MEASURED HOLE (survivor): no witnessed fixture executed an all-constant subexpression through the fold pass, so a fold arithmetic bug in evalBinOp('+') was invisible to the execution gates. CLOSED by conformance/witnesses/fold-execution.test.ts, whose accept/reject verdict depends on a folded constant (2n + 3n) and is checked by both the source-vs-script differential oracle and the fold-OFF/fold-ON oracle; the mutation now diverges both and is caught."
    }
  ]
}
