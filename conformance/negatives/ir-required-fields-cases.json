              "kind": "load_param",
              "name": "sig"
            }
          },
          {
            "name": "t1",
            "value": {
              "kind": "load_prop",
              "name": "pk"
            }
          },
          {
            "name": "t2",
            "value": {
              "kind": "call",
              "func": "checkSig",
              "args": [
                "t0",
                "t1"
              ]
            }
          },
          {
            "name": "t3",
            "value": {
              "kind": "assert",
              "value": "t2"
            }
          }
        ]
      }
    ]
