{
  "name": "runar-conformance",
  "version": "0.1.0",
  "private": true,
  "description": "Conformance test infrastructure for verifying Rúnar compiler implementations produce identical output",
  "type": "module",
  "scripts": {
    "test": "tsx runner/index.ts",
    "test:json": "tsx runner/index.ts --format json",
    "test:markdown": "tsx runner/index.ts --format markdown",
    "test:filter": "tsx runner/index.ts --filter",
    "test:parser-only": "tsx runner/index.ts --parser-only",
    "update-golden": "tsx runner/index.ts --update-golden",
    "script-size-check": "tsx runner/script-size-check.ts",
    "fuzz": "tsx fuzzer/index.ts",
    "fuzz:quick": "tsx fuzzer/index.ts --ir --compilers ts,go,rust,python,zig,ruby,java --render native --num 20",
    "fuzz:property": "tsx fuzzer/index.ts --property",
    "fuzz:anf": "tsx fuzzer/index.ts --anf --num 100 --time-budget-ms 30000",
    "fuzz:anf:thorough": "tsx fuzzer/index.ts --anf --num 1000 --time-budget-ms 300000",
    "fuzz:canonical": "tsx fuzzer/index.ts --canonical --num 200",
    "fuzz:canonical:fast": "tsx fuzzer/index.ts --canonical --num 200 --compilers ts,go,rust,python,zig,ruby",
    "fuzz:canonical:gate": "tsx fuzzer/index.ts --canonical --seed 20020602 --num 64 --compilers ts,go,rust,python,zig,ruby",
    "fuzz:execute": "tsx fuzzer/index.ts --execute --num 200 --time-budget-ms 60000",
    "fuzz:execute:gate": "tsx fuzzer/index.ts --execute --num 60 --seed 424242",
    "fuzz:metamorphic": "tsx fuzzer/metamorphic-fuzz.ts --num 200 --seed 424242",
    "fuzz:ir:gate": "tsx fuzzer/index.ts --ir --seed 424242 --num 40 --compilers ts,go,rust,python,zig,ruby,java --render native",
    "sdk-output": "tsx sdk-output/runner/sdk-runner.ts",
    "differential-witness": "vitest run witnesses/differential.test.ts",
    "mutation:score": "tsx mutation/run-mutation.ts"
  },
  "dependencies": {
    "fast-check": "^3.22.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
