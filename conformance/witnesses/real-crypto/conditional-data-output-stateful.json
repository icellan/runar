{
  "fixture": "conditional-data-output-stateful",
  "kind": "stateful",
  "signerKey": "alice",
  "note": "pay(flag,payload): checkPreimage + a conditional data output. Both flag branches must produce a spendable continuation.",
  "constructorArgs": [
    "0n"
  ],
  "spends": [
    {
      "method": "pay",
      "args": [
        true,
        "0xdead"
      ],
      "expect": "accept",
      "note": "flag true: emits data output",
      "expectedState": {
        "amount": "1n",
        "_spentOutpointHash": {
          "$spentOutpointHash": "deploy:0"
        }
      }
    },
    {
      "method": "pay",
      "args": [
        false,
        "0xdead"
      ],
      "expect": "accept",
      "note": "flag false: no data output",
      "expectedState": {
        "amount": "1n",
        "_spentOutpointHash": {
          "$spentOutpointHash": "deploy:0"
        }
      }
    },
    {
      "method": "pay",
      "args": [
        true,
        "0xdead"
      ],
      "tamperOutput": true,
      "cryptoNearMiss": true,
      "expect": "reject",
      "note": "tampered continuation output"
    }
  ],
  "goldenHashes": {
    "expected-script.hex": "5db5ea4fda385a3c8d41e7319199a855df4cd2c3a2bce6fff6e4a2077c9f3669",
    "expected-ir.json": "1f3a8eae1e948ebc99b337ce3bd6eca46f41566db34cd64bdfb844d0aff412b0"
  }
}
