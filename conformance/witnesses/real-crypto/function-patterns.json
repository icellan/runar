{
  "fixture": "function-patterns",
  "kind": "stateful",
  "note": "Stateful contract whose every public method is gated by a private requireOwner() -> real checkSig(owner). owner is set to the signer's pubkey for accept, to a different key for the wrong-signer near-miss. Real checkPreimage continuation.",
  "spends": [
    {
      "method": "deposit",
      "args": [
        null,
        "50n"
      ],
      "constructorArgs": [
        {
          "$pubkey": "alice"
        },
        "100n"
      ],
      "signerKey": "alice",
      "expect": "accept",
      "note": "owner==signer, deposit 50 -> balance 150",
      "expectedState": {
        "balance": "150n"
      },
      "artifactReadback": {
        "constructorArgs": {
          "owner": {
            "$pubkey": "alice"
          }
        },
        "codePartByteLength": 2999,
        "holds": [
          {
            "at": 546,
            "was": [
              "21",
              {
                "$pubkey": "alice"
              }
            ]
          },
          {
            "at": 1285,
            "was": [
              "21",
              {
                "$pubkey": "alice"
              }
            ]
          },
          {
            "at": 2051,
            "was": [
              "21",
              {
                "$pubkey": "alice"
              }
            ]
          },
          {
            "at": 2788,
            "was": [
              "21",
              {
                "$pubkey": "alice"
              }
            ]
          }
        ],
        "notDeployments": [
          {
            "name": "non-push opcode (OP_CHECKSIG) at the last owner reference",
            "edits": [
              {
                "at": 2788,
                "was": [
                  "21",
                  {
                    "$pubkey": "alice"
                  }
                ],
                "with": "ac"
              }
            ],
            "extractThrows": true
          },
          {
            "name": "second owner reference holds a different key",
            "edits": [
              {
                "at": 1285,
                "was": [
                  "21",
                  {
                    "$pubkey": "alice"
                  }
                ],
                "with": [
                  "21",
                  {
                    "$pubkey": "bob"
                  }
                ]
              }
            ]
          },
          {
            "name": "32-byte push at every 33-byte owner slot",
            "edits": [
              {
                "at": 546,
                "was": [
                  "21",
                  {
                    "$pubkey": "alice"
                  }
                ],
                "with": [
                  "20",
                  "1111111111111111111111111111111111111111111111111111111111111111"
                ]
              },
              {
                "at": 1285,
                "was": [
                  "21",
                  {
                    "$pubkey": "alice"
                  }
                ],
                "with": [
                  "20",
                  "1111111111111111111111111111111111111111111111111111111111111111"
                ]
              },
              {
                "at": 2051,
                "was": [
                  "21",
                  {
                    "$pubkey": "alice"
                  }
                ],
                "with": [
                  "20",
                  "1111111111111111111111111111111111111111111111111111111111111111"
                ]
              },
              {
                "at": 2788,
                "was": [
                  "21",
                  {
                    "$pubkey": "alice"
                  }
                ],
                "with": [
                  "20",
                  "1111111111111111111111111111111111111111111111111111111111111111"
                ]
              }
            ]
          },
          {
            "name": "code part with no OP_RETURN and no state",
            "dropStateTail": true
          }
        ]
      }
    },
    {
      "method": "deposit",
      "args": [
        null,
        "50n"
      ],
      "constructorArgs": [
        {
          "$pubkey": "bob"
        },
        "100n"
      ],
      "signerKey": "alice",
      "cryptoNearMiss": true,
      "expect": "reject",
      "note": "wrong signer: owner=bob, signed by alice -> checkSig fails"
    },
    {
      "method": "withdraw",
      "args": [
        null,
        "10n",
        "100n"
      ],
      "constructorArgs": [
        {
          "$pubkey": "alice"
        },
        "100n"
      ],
      "signerKey": "alice",
      "expect": "accept",
      "note": "owner-gated withdraw: fee=percentOf(10,100)=0, total 10 <= 100",
      "expectedState": {
        "balance": "90n"
      }
    },
    {
      "method": "scale",
      "args": [
        null,
        "3n",
        "2n"
      ],
      "constructorArgs": [
        {
          "$pubkey": "alice"
        },
        "100n"
      ],
      "signerKey": "alice",
      "expect": "accept",
      "note": "owner-gated scale: balance=mulDiv(100,3,2)=150",
      "expectedState": {
        "balance": "150n"
      }
    }
  ],
  "goldenHashes": {
    "expected-script.hex": "627b93eeda39bc8becfe676247f71e7866bc9e49b4c4423b5ddbcc8ceee2aef6"
  }
}
