{
  "fixture": "state-array-set",
  "kind": "stateful",
  "note": "ArraySet put(): FixedArray<bigint, 4> mutable state, the second witness for the shape fixed-array-write pins. Where fixed-array-write increments a slot, this assigns a caller-supplied value at a runtime index, so the write-back is pinned by hand rather than trusted to byte agreement.",
  "signerKey": "alice",
  "constructorArgs": [],
  "spends": [
    {
      "method": "put",
      "args": [
        "2n",
        "7n"
      ],
      "expect": "accept",
      "note": "runtime index 2 := 7, every other slot untouched",
      "expectedState": {
        "slots": [
          "0n",
          "0n",
          "7n",
          "0n"
        ]
      }
    },
    {
      "method": "put",
      "args": [
        "0n",
        "5n"
      ],
      "expect": "accept",
      "note": "first slot",
      "expectedState": {
        "slots": [
          "5n",
          "0n",
          "0n",
          "0n"
        ]
      }
    },
    {
      "method": "put",
      "args": [
        "3n",
        "9n"
      ],
      "expect": "accept",
      "note": "last slot",
      "expectedState": {
        "slots": [
          "0n",
          "0n",
          "0n",
          "9n"
        ]
      }
    },
    {
      "method": "put",
      "args": [
        "2n",
        "7n"
      ],
      "expect": "reject",
      "note": "tampered continuation output",
      "tamperOutput": true,
      "cryptoNearMiss": true
    }
  ],
  "goldenHashes": {
    "expected-script.hex": "2111008630510883a121d6bcfbeb7f70e1d9007b4c49bb83facf9337a1c6e259",
    "expected-ir.json": "1fbd051d1604002b724f8de6c11751c5b8a8d4d8e3188973efc37b0e6853a92d"
  }
}
