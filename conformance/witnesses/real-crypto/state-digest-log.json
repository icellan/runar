{
  "fixture": "state-digest-log",
  "kind": "stateful",
  "note": "DigestLog replace(): {Ripemd160} mutable state, the second witness for the shape state-ripemd160 pins, through a method that also takes a bigint argument and asserts on it.",
  "signerKey": "alice",
  "constructorArgs": [
    "0000000000000000000000000000000000000000"
  ],
  "spends": [
    {
      "method": "replace",
      "args": [
        "0x1111111111111111111111111111111111111111",
        "1n"
      ],
      "expect": "accept",
      "note": "digest -> new 20-byte hash, version 1 > 0",
      "expectedState": {
        "digest": "0x1111111111111111111111111111111111111111"
      }
    },
    {
      "method": "replace",
      "args": [
        "0x1111111111111111111111111111111111111111",
        "0n"
      ],
      "expect": "reject",
      "note": "version 0 is not > 0"
    },
    {
      "method": "replace",
      "args": [
        "0x1111111111111111111111111111111111111111",
        "1n"
      ],
      "expect": "reject",
      "note": "tampered continuation output",
      "tamperOutput": true,
      "cryptoNearMiss": true
    }
  ],
  "goldenHashes": {
    "expected-script.hex": "f8a18b1d6aaa10e954e136ea2e310d9c5dd7ca085a0e05191579ce8575f1dea1",
    "expected-ir.json": "26735ead57d447dd25c9a3beb30e64afe15cbde4eee88cac772b5659f1930393"
  }
}
