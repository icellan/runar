{
  "fixture": "state-leaderboard",
  "kind": "stateful",
  "note": "LeaderBoard claim(): {PubKey, bigint} mutable state, the second witness for the shape auction pins. A claim needs the current leader's real checkSig and a strictly higher score; both mutable fields are rewritten and the real checkPreimage continuation commits them.",
  "constructorArgs": [
    {
      "$pubkey": "alice"
    },
    "10n"
  ],
  "spends": [
    {
      "method": "claim",
      "args": [
        null,
        {
          "$pubkey": "bob"
        },
        "25n"
      ],
      "expect": "accept",
      "note": "alice (current leader) hands the board to bob with score 25 > 10",
      "signerKey": "alice",
      "expectedState": {
        "leader": {
          "$pubkey": "bob"
        },
        "topScore": "25n"
      }
    },
    {
      "method": "claim",
      "args": [
        null,
        {
          "$pubkey": "bob"
        },
        "25n"
      ],
      "expect": "reject",
      "note": "wrong signer: leader=alice but bob signs",
      "signerKey": "bob",
      "cryptoNearMiss": true
    },
    {
      "method": "claim",
      "args": [
        null,
        {
          "$pubkey": "bob"
        },
        "10n"
      ],
      "expect": "reject",
      "note": "score 10 is not greater than topScore 10",
      "signerKey": "alice"
    },
    {
      "method": "claim",
      "args": [
        null,
        {
          "$pubkey": "bob"
        },
        "25n"
      ],
      "expect": "reject",
      "note": "tampered continuation output: the covenant must bind the new leader and score",
      "signerKey": "alice",
      "tamperOutput": true,
      "cryptoNearMiss": true
    }
  ],
  "goldenHashes": {
    "expected-script.hex": "5fc9117df27b63298cc329dc4cd0b8e7a3b6e421d9bb47c512f9b1b851cd5dca",
    "expected-ir.json": "e1dbd269ef27c50d68a2d7f26c449e37d23d89f34c3473edae66555ef42313dd"
  }
}
