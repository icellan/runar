{
  "fixture": "state-notary",
  "kind": "stateful",
  "note": "Notary notarize(): {ByteString, PubKey, bigint} mutable state with the PubKey declared BEFORE the variable-length ByteString, the reverse of annotated-vault's order, so the on-chain reader walks a different layout. seq is read, incremented and written back.",
  "constructorArgs": [
    {
      "$pubkey": "alice"
    },
    "aabb",
    "0n"
  ],
  "spends": [
    {
      "method": "notarize",
      "args": [
        null,
        "0xccddee"
      ],
      "expect": "accept",
      "note": "signer replaces the note and seq 0 -> 1",
      "signerKey": "alice",
      "expectedState": {
        "signer": {
          "$pubkey": "alice"
        },
        "note": "0xccddee",
        "seq": "1n"
      }
    },
    {
      "method": "notarize",
      "args": [
        null,
        "0x"
      ],
      "expect": "accept",
      "note": "an empty note is a legal ByteString state value",
      "signerKey": "alice",
      "expectedState": {
        "signer": {
          "$pubkey": "alice"
        },
        "note": "0x",
        "seq": "1n"
      }
    },
    {
      "method": "notarize",
      "args": [
        null,
        "0xccddee"
      ],
      "expect": "reject",
      "note": "wrong signer: signer=alice but bob signs",
      "signerKey": "bob",
      "cryptoNearMiss": true
    },
    {
      "method": "notarize",
      "args": [
        null,
        "0xccddee"
      ],
      "expect": "reject",
      "note": "tampered continuation output",
      "signerKey": "alice",
      "tamperOutput": true,
      "cryptoNearMiss": true
    }
  ],
  "goldenHashes": {
    "expected-script.hex": "54ab039bcb4fad3a891e25070d75192a0dffa4f4d90a2bd6f9975b605b172868",
    "expected-ir.json": "07468ad6da667c8e6c2aa2d52f27e617b34214becc1912be76b8cb9c36613a4d"
  }
}
