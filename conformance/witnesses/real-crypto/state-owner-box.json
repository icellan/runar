{
  "fixture": "state-owner-box",
  "kind": "stateful",
  "note": "OwnerBox rotate(): {PubKey} mutable state, the second witness for the shape token-nft pins. Ownership moves by assigning the property (auto-continuation), not by addOutput.",
  "constructorArgs": [
    {
      "$pubkey": "alice"
    }
  ],
  "spends": [
    {
      "method": "rotate",
      "args": [
        null,
        {
          "$pubkey": "bob"
        }
      ],
      "expect": "accept",
      "note": "alice rotates ownership to bob",
      "signerKey": "alice",
      "expectedState": {
        "owner": {
          "$pubkey": "bob"
        }
      }
    },
    {
      "method": "rotate",
      "args": [
        null,
        {
          "$pubkey": "bob"
        }
      ],
      "expect": "reject",
      "note": "wrong signer: owner=alice but bob signs",
      "signerKey": "bob",
      "cryptoNearMiss": true
    },
    {
      "method": "rotate",
      "args": [
        null,
        {
          "$pubkey": "bob"
        }
      ],
      "expect": "reject",
      "note": "tampered continuation output",
      "signerKey": "alice",
      "tamperOutput": true,
      "cryptoNearMiss": true
    }
  ],
  "goldenHashes": {
    "expected-script.hex": "6458e3733868059e9d739115dcc7092a0fcea9c90fc26d3e6df0a2aded3f0b4d",
    "expected-ir.json": "22da174abebb131f529f409fde50e128c545d46168e84b08f564b43eda93d97c"
  }
}
