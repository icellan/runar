{
  "fixture": "state-owner-box",
  "kind": "stateful",
  "note": "OwnerBox rotate(): {PubKey} mutable state, the second witness for the shape token-nft pins. Ownership moves by assigning the property (auto-continuation), not by addOutput.",
  "constructorArgs": [
    {
      "$pubkey": "alice"
    }
  ],
  "spends": [
    {
      "method": "rotate",
      "args": [
        null,
        {
          "$pubkey": "bob"
        }
      ],
      "expect": "accept",
      "note": "alice rotates ownership to bob",
      "signerKey": "alice",
      "expectedState": {
        "owner": {
          "$pubkey": "bob"
        }
      }
    },
    {
      "method": "rotate",
      "args": [
        null,
        {
          "$pubkey": "bob"
        }
      ],
      "expect": "reject",
      "note": "wrong signer: owner=alice but bob signs",
      "signerKey": "bob",
      "cryptoNearMiss": true
    },
    {
      "method": "rotate",
      "args": [
        null,
        {
          "$pubkey": "bob"
        }
      ],
      "expect": "reject",
      "note": "tampered continuation output",
      "signerKey": "alice",
      "tamperOutput": true,
      "cryptoNearMiss": true
    }
  ],
  "goldenHashes": {
    "expected-script.hex": "5c1e8eef64cec05a8dc0d6d4237528eeb89e2eaaa8330c2974d5bf64dac03d6b",
    "expected-ir.json": "70b9792b3afb6a98bf4b260ffd2d56b97cda80c7b5edc61096392e0506b31184"
  }
}
