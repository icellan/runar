{
  "fixture": "stateful-counter",
  "kind": "stateful",
  "signerKey": "alice",
  "note": "BUG-100 class: Counter increment/decrement with real checkPreimage continuation.",
  "constructorArgs": [
    "5n"
  ],
  "spends": [
    {
      "method": "increment",
      "args": [],
