{
  "fixture": "token-ft",
  "kind": "stateful",
  "note": "FungibleToken send(): real checkSig(owner) then a single continuation output carrying the transferred balance to the new owner. Real checkPreimage continuation.",
  "spends": [
    {
      "method": "send",
      "args": [
        null,
        {
          "$pubkey": "bob"
        },
        "1n"
      ],
      "constructorArgs": [
        {
          "$pubkey": "alice"
        },
        "10n",
        "0n",
        "01"
      ],
      "signerKey": "alice",
      "satoshis": 1,
      "expect": "accept",
      "note": "owner sends full balance (10) to bob",
      "expectedState": {
        "owner": {
          "$pubkey": "bob"
        },
        "balance": "10n",
        "mergeBalance": "0n"
      }
    },
    {
      "method": "send",
      "args": [
        null,
        {
          "$pubkey": "bob"
        },
        "1n"
      ],
      "constructorArgs": [
        {
          "$pubkey": "bob"
        },
        "10n",
        "0n",
        "01"
      ],
      "signerKey": "alice",
      "satoshis": 1,
      "cryptoNearMiss": true,
      "expect": "reject",
      "note": "wrong signer: owner=bob signed by alice"
    }
  ],
  "goldenHashes": {
    "expected-script.hex": "3b615cdbe90623922030ce21ca2abd7da2d42e90ad934ad6af4de688a42068e2",
    "expected-ir.json": "5d2557b57bae9a2fd2a5502af3d8b7d829f04850f260f807c320f35892717197"
  }
}
