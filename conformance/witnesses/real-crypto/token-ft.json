{
  "fixture": "token-ft",
  "kind": "stateful",
  "note": "FungibleToken send(): real checkSig(owner) then a single continuation output carrying the transferred balance to the new owner. Real checkPreimage continuation. N-045: owner (PubKey) is now width-checked (OP_SIZE 33 OP_NUMEQUALVERIFY) before every addOutput commit. The WideHash near-miss below is built by an attacker SDK (attackerFieldWidths) because our own SDK refuses a wrong-width PubKey argument.",
  "spends": [
    {
      "method": "send",
      "args": [
        null,
        {
          "$pubkey": "bob"
        },
        "1n"
      ],
      "constructorArgs": [
        {
          "$pubkey": "alice"
        },
        "10n",
        "0n",
        "01"
      ],
      "signerKey": "alice",
      "satoshis": 1,
      "expect": "accept",
      "note": "owner sends full balance (10) to bob",
      "expectedState": {
        "owner": {
          "$pubkey": "bob"
        },
        "balance": "10n",
        "mergeBalance": "0n"
      },
      "templateHash": {
        "hash256": "2ff69aa12a0a1cfd9a15d878c9f950d68edd216d7d33367fd3dc6094ed97890f",
        "codePartByteLength": 3035,
        "slots": [
          {
            "param": "tokenId",
            "at": 2119,
            "was": "51",
            "encoding": "op-n",
            "pushHeaderBytes": 0
          }
        ]
      }
    },
    {
      "method": "send",
      "args": [
        null,
        {
          "$pubkey": "bob"
        },
        "1n"
      ],
      "constructorArgs": [
        {
          "$pubkey": "alice"
        },
        "10n",
        "0n",
        "81"
      ],
      "signerKey": "alice",
      "satoshis": 1,
      "expect": "accept",
      "note": "tokenId 0x81 deploys as OP_1NEGATE; same template hash as tokenId 0x01 (OP_1)",
      "expectedState": {
        "owner": {
          "$pubkey": "bob"
        },
        "balance": "10n",
        "mergeBalance": "0n"
      },
      "templateHash": {
        "hash256": "2ff69aa12a0a1cfd9a15d878c9f950d68edd216d7d33367fd3dc6094ed97890f",
        "codePartByteLength": 3035,
        "slots": [
          {
            "param": "tokenId",
            "at": 2119,
            "was": "4f",
            "encoding": "op-1negate",
            "pushHeaderBytes": 0
          }
        ]
      }
    },
    {
      "method": "send",
      "args": [
        null,
        {
          "$pubkey": "bob"
        },
        "1n"
      ],
      "constructorArgs": [
        {
          "$pubkey": "bob"
        },
        "10n",
        "0n",
        "01"
      ],
      "signerKey": "alice",
      "satoshis": 1,
      "cryptoNearMiss": true,
      "expect": "reject",
      "note": "wrong signer: owner=bob signed by alice"
    },
    {
      "method": "send",
      "args": [
        null,
        "0x03d6bfe100d1600c0d8f769501676fc74c3809500bd131c8a549f88cf616c21f3500",
        "1n"
      ],
      "constructorArgs": [
        {
          "$pubkey": "alice"
        },
        "10n",
        "0n",
        "01"
      ],
      "signerKey": "alice",
      "satoshis": 1,
      "attackerFieldWidths": {
        "PubKey": 34
      },
      "cryptoNearMiss": true,
      "expect": "reject",
      "note": "N-045 WIDEHASH: the owner sends to a 34-byte recipient (bob's key + 0x00). Pre-fix the continuation committed all 34 bytes and the next reader (which takes the last 49 bytes) read owner as bob's key shifted by one byte, a key nobody holds; post-fix the covenant's own width check rejects the send on the real Spend engine."
    }
  ],
