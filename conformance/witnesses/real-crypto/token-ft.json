{
  "fixture": "token-ft",
  "kind": "stateful",
  "note": "FungibleToken send(): real checkSig(owner) then a single continuation output carrying the transferred balance to the new owner. Real checkPreimage continuation.",
  "spends": [
    {
      "method": "send",
      "args": [
        null,
        {
          "$pubkey": "bob"
        },
        "1n"
      ],
      "constructorArgs": [
        {
          "$pubkey": "alice"
        },
        "10n",
        "0n",
        "01"
      ],
      "signerKey": "alice",
      "satoshis": 1,
      "expect": "accept",
      "note": "owner sends full balance (10) to bob",
      "expectedState": {
        "owner": {
          "$pubkey": "bob"
        },
        "balance": "10n",
        "mergeBalance": "0n"
      }
    },
    {
      "method": "send",
      "args": [
        null,
        {
          "$pubkey": "bob"
        },
        "1n"
      ],
      "constructorArgs": [
        {
          "$pubkey": "bob"
        },
        "10n",
        "0n",
        "01"
      ],
      "signerKey": "alice",
      "satoshis": 1,
      "cryptoNearMiss": true,
      "expect": "reject",
      "note": "wrong signer: owner=bob signed by alice"
    }
  ],
  "goldenHashes": {
    "expected-script.hex": "4f98b29db6028362ad68305a433a0e551059e0b5a13796b3d083074f49beef2f",
    "expected-ir.json": "bfff122f24fbb69aae7a61889d890544d6cc7176a8ce1e10f324f95ff5f7424e"
  }
}
