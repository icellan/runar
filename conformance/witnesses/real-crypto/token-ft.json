{
  "fixture": "token-ft",
  "kind": "stateful",
  "note": "FungibleToken send(): real checkSig(owner) then a single continuation output carrying the transferred balance to the new owner. Real checkPreimage continuation.",
  "spends": [
    {
      "method": "send",
      "args": [
        null,
        {
          "$pubkey": "bob"
        },
        "1n"
      ],
      "constructorArgs": [
        {
          "$pubkey": "alice"
        },
        "10n",
        "0n",
        "01"
      ],
      "signerKey": "alice",
      "satoshis": 1,
      "expect": "accept",
      "note": "owner sends full balance (10) to bob",
      "expectedState": {
        "owner": {
          "$pubkey": "bob"
        },
        "balance": "10n",
        "mergeBalance": "0n"
      }
    },
    {
      "method": "send",
      "args": [
        null,
        {
          "$pubkey": "bob"
        },
        "1n"
      ],
      "constructorArgs": [
        {
          "$pubkey": "bob"
        },
        "10n",
        "0n",
        "01"
      ],
      "signerKey": "alice",
      "satoshis": 1,
      "cryptoNearMiss": true,
      "expect": "reject",
      "note": "wrong signer: owner=bob signed by alice"
    }
  ],
  "goldenHashes": {
    "expected-script.hex": "7cf33d653527c3ee65cfcb969fc2ff1a1db0ed103fca59d4accef6d5fa87623c",
    "expected-ir.json": "eb93a36135f68712a65192d220f29478de2f3cbe1748cd300264122587f94973"
  }
}
