{
  "fixture": "token-nft",
  "kind": "stateful",
  "note": "SimpleNFT: transfer()/burn() gated by real checkSig(owner). Real checkPreimage continuation + a transfer output. N-045: owner (PubKey) is now width-checked (OP_SIZE 33 OP_NUMEQUALVERIFY) before the addOutput commit. The WideHash near-miss below is built by an attacker SDK (attackerFieldWidths) because our own SDK refuses a wrong-width PubKey argument.",
  "spends": [
    {
      "method": "burn",
      "args": [
        null
      ],
      "constructorArgs": [
        {
          "$pubkey": "alice"
        },
        "01",
        "02"
      ],
      "signerKey": "alice",
      "expect": "accept",
      "note": "owner burn: real checkSig(alice)",
      "expectedState": {
        "owner": {
          "$pubkey": "alice"
        }
      }
    },
    {
      "method": "burn",
      "args": [
        null
      ],
      "constructorArgs": [
        {
          "$pubkey": "bob"
        },
        "01",
        "02"
      ],
      "signerKey": "alice",
      "cryptoNearMiss": true,
      "expect": "reject",
      "note": "wrong signer: owner=bob signed by alice"
    },
    {
      "method": "transfer",
      "args": [
        null,
        {
          "$pubkey": "bob"
        },
        "1n"
      ],
      "constructorArgs": [
        {
          "$pubkey": "alice"
        },
        "01",
        "02"
      ],
      "signerKey": "alice",
      "satoshis": 1,
      "expect": "accept",
      "note": "owner transfer to bob, 1 sat output",
      "expectedState": {
        "owner": {
          "$pubkey": "bob"
        }
      }
    },
    {
      "method": "transfer",
      "args": [
        null,
        "0x03d6bfe100d1600c0d8f769501676fc74c3809500bd131c8a549f88cf616c21f3500",
        "1n"
      ],
      "constructorArgs": [
        {
          "$pubkey": "alice"
        },
        "01",
        "02"
      ],
      "signerKey": "alice",
      "satoshis": 1,
      "attackerFieldWidths": {
        "PubKey": 34
      },
      "cryptoNearMiss": true,
      "expect": "reject",
      "note": "N-045 WIDEHASH: the owner transfers to a 34-byte newOwner (bob's key + 0x00). Pre-fix the continuation committed all 34 bytes and the next reader took the last 33 as owner, a key nobody holds; post-fix the covenant's own width check rejects the transfer on the real Spend engine."
    }
  ],
  "goldenHashes": {
    "expected-script.hex": "e80a930b7ca07179ccdec23afd55dee2c2088649a2132d8dede78277859b7bec"
  }
