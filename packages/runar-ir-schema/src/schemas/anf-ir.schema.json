{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runar.dev/schemas/anf-ir.schema.json",
  "title": "Rúnar ANF IR",
  "description": "A-Normal Form intermediate representation — the canonical conformance boundary for Rúnar compilers.",
  "type": "object",
  "required": ["contractName", "properties", "methods"],
  "additionalProperties": false,
  "properties": {
    "contractName": {
      "type": "string",
      "minLength": 1
    },
    "properties": {
      "type": "array",
      "items": { "$ref": "#/$defs/ANFProperty" }
    },
    "methods": {
      "type": "array",
      "items": { "$ref": "#/$defs/ANFMethod" }
    },
    "parentClass": {
      "enum": ["SmartContract", "StatefulSmartContract", "UnsafeSmartContract"],
      "description": "F-038: the base class the source contract extends. Every tier's --emit-ir writes it; it is optional on input only so IR written before it existed still loads (the artifact then has no parentClass). The artifact copies it to its top-level parentClass, which the SDKs read to gate the issue-#42/#44 OP_CODESEPARATOR subscript trim: a StatefulSmartContract with zero mutable fields has empty stateFields and still needs the trim."
    }
  },
  "$defs": {
    "ANFProperty": {
      "type": "object",
      "required": ["name", "type", "readonly"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "readonly": { "type": "boolean" },
        "initialValue": {
          "oneOf": [
            { "type": "string" },
            { "type": "integer" },
            { "type": "boolean" }
          ]
        },
        "syntheticArrayChain": {
          "type": "array",
          "minItems": 1,
          "description": "Present only on a scalar leaf minted by the expand-fixed-arrays pass. One entry per FixedArray nesting level, outermost first. The artifact assembler consumes one level per pass to regroup the synthetic siblings back into a single FixedArray state/ABI entry, so dropping this field silently degrades the SDK's accessor into N raw scalars.",
          "items": { "$ref": "#/$defs/ANFSyntheticArrayLevel" }
        }
      }
    },
    "ANFSyntheticArrayLevel": {
      "type": "object",
      "required": ["base", "index", "length"],
      "additionalProperties": false,
      "properties": {
        "base": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 1 }
      }
    },
    "ANFMethod": {
      "type": "object",
      "required": ["name", "params", "body", "isPublic"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "params": {
          "type": "array",
          "items": { "$ref": "#/$defs/ANFParam" }
        },
        "body": {
          "type": "array",
          "items": { "$ref": "#/$defs/ANFBinding" }
        },
        "isPublic": { "type": "boolean" },
        "sigHashType": {
          "enum": [65, 66, 67, 193, 194, 195],
          "description": "F-065 / F-088: the BIP-143 sighash type a `@sighash` directive declared for this method (ALL/NONE/SINGLE, optionally ANYONECANPAY, always FORKID). Omitted for the default ALL|FORKID (65). The artifact copies it to abi.methods[].sigHashType, which the SDKs read to build the preimage the covenant asserts; the check_preimage node's sighashFlag drives the script bytes."
        }
      }
    },
    "ANFParam": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "ANFBinding": {
      "type": "object",
      "required": ["name", "value"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/ANFValue" },
        "sourceLoc": {
          "type": "object",
          "additionalProperties": false,
          "description": "Debug-only: source location of the originating AST node. Not part of conformance.",
          "required": ["file", "line", "column"],
          "properties": {
            "file": { "type": "string" },
            "line": { "type": "integer", "minimum": 0 },
            "column": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "ANFValue": {
      "oneOf": [
        { "$ref": "#/$defs/LoadParam" },
        { "$ref": "#/$defs/LoadProp" },
        { "$ref": "#/$defs/LoadConst" },
        { "$ref": "#/$defs/BinOp" },
        { "$ref": "#/$defs/UnaryOp" },
        { "$ref": "#/$defs/Call" },
        { "$ref": "#/$defs/MethodCall" },
        { "$ref": "#/$defs/If" },
        { "$ref": "#/$defs/Loop" },
        { "$ref": "#/$defs/Assert" },
        { "$ref": "#/$defs/UpdateProp" },
        { "$ref": "#/$defs/GetStateScript" },
        { "$ref": "#/$defs/CheckPreimage" },
        { "$ref": "#/$defs/DeserializeState" },
        { "$ref": "#/$defs/AddOutput" },
        { "$ref": "#/$defs/AddRawOutput" },
        { "$ref": "#/$defs/AddDataOutput" },
        { "$ref": "#/$defs/ArrayLiteral" },
        { "$ref": "#/$defs/RawScript" }
      ]
    },
    "LoadParam": {
      "type": "object",
      "required": ["kind", "name"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "load_param" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "LoadProp": {
      "type": "object",
      "required": ["kind", "name"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "load_prop" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "LoadConst": {
      "type": "object",
      "required": ["kind", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "load_const" },
        "value": {
          "oneOf": [
            { "type": "string" },
            { "type": "integer" },
            { "type": "boolean" }
          ]
        }
      }
    },
    "BinOp": {
      "type": "object",
      "required": ["kind", "op", "left", "right"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "bin_op" },
        "op": { "type": "string", "minLength": 1 },
        "left": { "type": "string", "minLength": 1 },
        "right": { "type": "string", "minLength": 1 },
        "result_type": {
          "type": "string",
          "minLength": 1,
          "description": "Operand type hint: 'bytes' for ByteString/PubKey/Sig/Sha256 etc., omitted for numeric"
        }
      }
    },
    "UnaryOp": {
      "type": "object",
      "required": ["kind", "op", "operand"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "unary_op" },
        "op": { "type": "string", "minLength": 1 },
        "operand": { "type": "string", "minLength": 1 },
        "result_type": {
          "type": "string",
          "minLength": 1,
          "description": "Operand type hint: 'bytes' for ByteString, omitted for numeric"
        }
      }
    },
    "Call": {
      "type": "object",
      "required": ["kind", "func", "args"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "call" },
        "func": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "MethodCall": {
      "type": "object",
      "required": ["kind", "object", "method", "args"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "method_call" },
        "object": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "If": {
      "type": "object",
      "required": ["kind", "cond", "then", "else"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "if" },
        "cond": { "type": "string", "minLength": 1 },
        "then": {
          "type": "array",
          "items": { "$ref": "#/$defs/ANFBinding" }
        },
        "else": {
          "type": "array",
          "items": { "$ref": "#/$defs/ANFBinding" }
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
"Loop": {
      "type": "object",
      "required": ["kind", "count", "body", "iterVar", "start", "step"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "loop" },
        "count": { "type": "integer", "minimum": 0 },
        "body": {
          "type": "array",
          "items": { "$ref": "#/$defs/ANFBinding" }
        },
        "iterVar": { "type": "string", "minLength": 1 },
        "start": {
          "oneOf": [
            { "type": "integer" },
            { "type": "string" }
          ]
        },
        "step": { "type": "integer", "enum": [1, -1] }
      }
    },
    "Assert": {
      "type": "object",
      "required": ["kind", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "assert" },
        "value": { "type": "string", "minLength": 1 },
        "isAutoInjectedStateCheck": { "type": "boolean" }
      }
    },
    "UpdateProp": {
      "type": "object",
      "required": ["kind", "name", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "update_prop" },
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "GetStateScript": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "get_state_script" }
      }
    },
    "CheckPreimage": {
      "type": "object",
      "required": ["kind", "preimage"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "check_preimage" },
        "preimage": { "type": "string", "minLength": 1 },
        "sighashFlag": {
          "enum": [65, 66, 67, 193, 194, 195],
          "description": "Issue #123: BIP-143 sighash byte the on-chain OP_PUSH_TX binding appends to the derived signature. Emitted by every tier for a method declaring a non-default `@sighash` mode; ABSENT means the default ALL|FORKID (0x41), which keeps every pre-existing golden byte-identical. N-059: only the six FORKID modes the `@sighash` grammar produces; any other value (including 0) is a byte no BSV spend can satisfy. In a public method it must also equal the method's sigHashType (default 65), which the --ir loaders enforce."
        },
        "bindingVariant": {
          "enum": ["lowS", "all"],
          "description": "The Any-S OP_PUSH_TX binding construction, from a `@bindingVariant` directive on the method (ports #170). ABSENT means the default lowS (422-byte low-S blob, valid at every nVersion). `all` selects the 376-byte non-low-S blob, which is only spendable when the spending tx has nVersion > 1. Emitted only for a method that opts in, so every pre-existing golden is unchanged."
        }
      }
    },
    "DeserializeState": {
      "type": "object",
      "required": ["kind", "preimage"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "deserialize_state" },
        "preimage": {
          "type": "string",
          "minLength": 1,
          "description": "Reference to a temp name holding the verified preimage"
        }
      }
    },
    "AddOutput": {
      "type": "object",
      "required": ["kind", "satoshis", "stateValues", "preimage"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "add_output" },
        "satoshis": { "type": "string", "minLength": 1 },
        "stateValues": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "preimage": {
          "type": "string",
          "description": "Reference to a temp holding the verified preimage (for codePart extraction). The EMPTY STRING is the wire-format sentinel for \"no preimage temp\" — emitted by all seven tiers for an explicit `this.addOutput(...)`, and read as \"no ref\" by stack lowering. The key itself is always present."
        }
      }
    },
    "AddRawOutput": {
      "type": "object",
      "required": ["kind", "satoshis", "scriptBytes"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "add_raw_output" },
        "satoshis": { "type": "string", "minLength": 1 },
        "scriptBytes": { "type": "string", "minLength": 1 }
      }
    },
    "AddDataOutput": {
      "type": "object",
      "required": ["kind", "satoshis", "scriptBytes"],
      "additionalProperties": false,
      "description": "Additional transaction output emitted by a stateful method. Included in the auto-computed continuation hash after state outputs and before the change output. Wire format matches add_raw_output: amount(8LE) + varint(scriptLen) + scriptBytes.",
      "properties": {
        "kind": { "const": "add_data_output" },
        "satoshis": { "type": "string", "minLength": 1 },
        "scriptBytes": { "type": "string", "minLength": 1 }
      }
    },
    "ArrayLiteral": {
      "type": "object",
      "required": ["kind", "elements"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "array_literal" },
        "elements": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "RawScript": {
      "type": "object",
      "required": ["kind", "bytes", "in_arity", "out_arity"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "raw_script" },
        "bytes": { "type": "string", "pattern": "^([0-9a-fA-F]{2})*$" },
        "in_arity": { "type": "integer", "minimum": 0 },
        "out_arity": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
