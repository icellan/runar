{
  "_doc": "F-033: native Zig math builtins vs the compiled script. Every `expect` here is the verdict of the TS-compiled script on @bsv/sdk Spend.validate (asserted by packages/runar-testing/src/__tests__/f033-zig-native-math-onchain.test.ts); packages/runar-zig/src/builtins_math_onchain_test.zig asserts the native Zig runtime returns the same value. `expect: \"abort\"` means the script fails (the native runtime must abort, which examples/zig covers through assert_probe). Integers only; all values fit i64.",
  "cases": [
    { "fn": "percentOf", "args": [10000, 250], "expect": 250 },
    { "fn": "percentOf", "args": [1000, 250], "expect": 25 },
    { "fn": "percentOf", "args": [100, 5], "expect": 0 },
    { "fn": "percentOf", "args": [400, 25], "expect": 1 },
    { "fn": "percentOf", "args": [-15000, 1], "expect": -1 },
    { "fn": "percentOf", "args": [15000, -1], "expect": -1 },
    { "fn": "percentOf", "args": [-1, 1], "expect": 0 },
    { "fn": "percentOf", "args": [-20001, 1], "expect": -2 },
    { "fn": "percentOf", "args": [-9999, -1], "expect": 0 },
    { "fn": "percentOf", "args": [-30000, -1], "expect": 3 },

    { "fn": "mulDiv", "args": [7, 11, 3], "expect": 25 },
    { "fn": "mulDiv", "args": [-7, 1, 2], "expect": -3 },
    { "fn": "mulDiv", "args": [7, -1, 2], "expect": -3 },
    { "fn": "mulDiv", "args": [7, 1, -2], "expect": -3 },
    { "fn": "mulDiv", "args": [-7, -1, -2], "expect": -3 },
    { "fn": "mulDiv", "args": [1, 1, 0], "expect": "abort" },

    { "fn": "safediv", "args": [17, 5], "expect": 3 },
