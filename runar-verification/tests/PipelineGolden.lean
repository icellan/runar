  -- select, the affine tangent select and the canonicity guard. With those
  -- ported, a live `RUNAR_VERIFICATION_REGEN=1` reproduces all four goldens
  -- byte-for-byte, so their anchors are live again.)
  --
  -- unpopulated: new mixed P-256/K1 wallet; a live Lean compile is deferred
  -- with the other synthesized crypto fixtures and must never be replaced by
  -- pasting the TypeScript golden into the stored-constant table.
  "r1-k1-wallet",
  -- unpopulated: no stored constant yet (SLH-DSA *f/*s parameter sets)
  "post-quantum-slhdsa-128f",
  "post-quantum-slhdsa-192f",
  "post-quantum-slhdsa-192s",
  "post-quantum-slhdsa-256f",
  "post-quantum-slhdsa-256s"
]

