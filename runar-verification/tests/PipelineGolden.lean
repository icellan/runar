-/
-- Fixtures whose goldens the real compilers produce but this model does not,
-- because the model's lowering diverges from the reference — tracked here so
-- the bucket inventory stays complete and the gap is visible rather than
-- silently missing from every list.
--
-- All three entries are the same minimality-normalisation divergence: the compilers insert
-- one OP_BIN2NUM (0x81) at every NUMERIC READ of a byte-array result, because
-- OP_LSHIFT / OP_RSHIFT / OP_AND / OP_XOR / OP_INVERT preserve operand width
-- and can leave a non-minimal buffer that the next numeric consumer rejects
-- under requireMinimal (deployed-and-unspendable, which is why the fix
-- shipped). shift-ops 27 -> 31 bytes, bitwise-ops 96 -> 108. This model still
-- emits the PRE-fix bytes, so it correctly fails to match those goldens.
--
-- The compilers are right and the model lags. Porting the normalisation into
-- Stack/Lower.lean moves both back to baselineMatches and the gate 58 -> 60.
--
-- Empty after byte-builtins (int2str / reverseBytes / split NIP) and
-- math-demo (R-169 pow guard + 256-round min-clamped sqrt) promoted.
def lowerDivergencePending : List String := []

def fixtureBuckets : List (String × List String) := [
  ("baselineMatches", baselineMatches),
  ("goOnlyFixtures", goOnlyFixtures),
  ("cryptoAxiomPending", cryptoAxiomPending),
  ("mathBuiltinsPending", mathBuiltinsPending),
  ("lowerDivergencePending", lowerDivergencePending)
]

def trackedFixtures : List String :=
  baselineMatches ++ goOnlyFixtures ++ cryptoAxiomPending
    ++ mathBuiltinsPending ++ lowerDivergencePending

def findDuplicates (xs : List String) : List String :=
  let rec loop (rest seen dups : List String) : List String :=
    match rest with
    | [] => dups.reverse
    | x :: tail =>
        if seen.contains x then
          if dups.contains x then loop tail seen dups
          else loop tail seen (x :: dups)
        else
          loop tail (x :: seen) dups
  loop xs [] []

def missingFrom (expected actual : List String) : List String :=
  expected.filter (fun x => !(actual.contains x))

def indexOf? (needle : String) (xs : List String) : Option Nat :=
  let rec loop (rest : List String) (idx : Nat) : Option Nat :=
    match rest with
    | [] => none
    | x :: tail => if x == needle then some idx else loop tail (idx + 1)
  loop xs 0

def assignedToShard (name : String) (shard shards : Nat) : Bool :=
  match indexOf? name cryptoAxiomPending with
  | none => false
  | some idx => (idx % shards) + 1 == shard

def parsePositiveEnv (name : String) : IO (Option Nat) := do
  match (← IO.getEnv name) with
  | none => pure none
  | some raw =>
      match raw.toNat? with
      | some n =>
          if n > 0 then pure (some n)
          else throw (IO.userError s!"{name} must be a positive integer, got {raw}")
      | none =>
          throw (IO.userError s!"{name} must be a positive integer, got {raw}")

def readShardSpec : IO (Option (Nat × Nat)) := do
  let shard ← parsePositiveEnv "RUNAR_VERIFICATION_SHARD"
  let shards ← parsePositiveEnv "RUNAR_VERIFICATION_SHARDS"
  match shard, shards with
  | none, none => pure none
  | some s, some n =>
      if s <= n then pure (some (s, n))
      else throw (IO.userError s!"RUNAR_VERIFICATION_SHARD ({s}) must be <= RUNAR_VERIFICATION_SHARDS ({n})")
  | _, _ =>
      throw (IO.userError "RUNAR_VERIFICATION_SHARD and RUNAR_VERIFICATION_SHARDS must be set together")

def cryptoExpectedClause (entry : String × String) : String :=
  s!"  | \"{entry.1}\" => some \"{entry.2}\""

/-- Finding #24: a regenerated constant ships with the provenance record that
makes it evidence. Every regen'd fixture was live-compiled by the model on disk,
so it is `.regenLive` at that run's fingerprint. -/
def cryptoProvenanceClause (fingerprint : String) (entry : String × String) : String :=
  s!"  ⟨\"{entry.1}\", .regenLive, \"{fingerprint}\"⟩,"

def cryptoExpectedSnippet (fingerprint : String) (entries : List (String × String)) : String :=
  String.intercalate "\n"
    (["-- Generated by RUNAR_VERIFICATION_REGEN=1 pipelineGolden.",
      s!"-- Model fingerprint at regen: {fingerprint}",
      "-- Review before pasting into tests/PipelineGolden.lean.",
      "def cryptoAxiomPendingExpected : String → Option String :="] ++
      entries.map cryptoExpectedClause ++
      ["  | _ => none",
       "",
       "-- Matching provenance entries (finding #24). Paste these over the",
       "-- corresponding cryptoAxiomPendingProvenance rows and set",
       s!"--   def modelFingerprintAdopted : String := \"{fingerprint}\"",
       "-- Rows NOT regenerated by this run must also be re-attested (or",
       "-- regenerated) — they still carry the previous fingerprint and the",
       "-- default-mode provenance gate will fail until they are addressed."] ++
      entries.map (cryptoProvenanceClause fingerprint) ++
      [""])

/--
Sanity check (2026-06-25 re-sync): 39 baseline + 0 Go-only + 20 crypto-pending
+ 0 math-pending + 5 lower-divergence = 64, matching `conformance/tests/`.
Previously: 34 baseline + 0 Go-only + 15 crypto-pending + 0 math-pending
+ 0 lower-divergence = 49, matching `conformance/tests/`.

Phase 4-J moved `babybear` and `babybear-ext4` from the Go-only bucket to
`cryptoAxiomPending` after `RunarVerification/Stack/BabyBear.lean` landed.

Phase 4-K moved `merkle-proof` and `state-covenant` from the Go-only bucket
to `cryptoAxiomPending` after `RunarVerification/Stack/Merkle.lean` landed.

Phase 7.1.c (this commit) moved `if-without-else-multi-temp` from
`lowerDivergencePending` to `baselineMatches` after the shadow-rebind
double-push bug in `lowerIf` was closed. Baseline 33 → 34.
-/
example : baselineMatches.length + goOnlyFixtures.length
        + cryptoAxiomPending.length + mathBuiltinsPending.length
        + lowerDivergencePending.length = 84 := by rfl

/-! ### Finding #24 — the hand-maintained counts are pinned to the buckets

`expectedFixtureTotal` / `expectedByteExact` used to be free-floating literals
that could (and did — `expectedFixtureTotal` said 49 while 64 fixtures existed)
drift from reality without failing anything. These `example`s make a drifted
number a COMPILE error, and `main` additionally enforces both with `=` against
what the run actually observed. Moving a fixture between buckets now forces the
counts to be rebaselined in the same change. -/

/-- The discovered-fixture gate must equal the bucket inventory it is derived
from. -/
example : expectedFixtureTotal = trackedFixtures.length := by rfl

/-- The byte-exact gate must equal what the default mode can actually verify:
every baseline fixture, plus every crypto anchor that is not declared inert. -/
example : expectedByteExact
        = baselineMatches.length + (cryptoAxiomPending.length - cryptoAnchorGaps.length) := by rfl

/-- Every crypto anchor carries exactly one provenance record (the set equality
itself is enforced by name in `main`). -/
example : cryptoAxiomPendingProvenance.length = cryptoAxiomPending.length := by rfl

def main : IO Unit := do
  -- Resolve relative to the repo root. CI runs us from `runar-verification/`
  -- via `lake env`, so the conformance tree sits one level up. Local macOS
  -- runs via `lake env lean --run tests/PipelineGolden.lean` set the same cwd.
  let dir := "../conformance/tests"
  -- Finding #24: fingerprint the Lean model that the stored crypto byte anchors
  -- claim to come from. Computed BEFORE any fixture work so a wrong working
  -- directory fails immediately and loudly instead of skipping the gate.
  let modelFingerprint ← computeModelFingerprint
  let entries ← System.FilePath.readDir dir
  -- Determine modes once up front so the cryptoAxiomPending bucket
  -- gating + per-fixture timing all observe the same flags.
  let full ← match (← IO.getEnv "RUNAR_VERIFICATION_FULL") with
    | some _ => pure true
    | none   => pure false
  let regen ← match (← IO.getEnv "RUNAR_VERIFICATION_REGEN") with
    | some _ => pure true
    | none   => pure false
  let shardSpec ← readShardSpec
  if shardSpec.isSome && !(full || regen) then
    throw (IO.userError "RUNAR_VERIFICATION_SHARD requires RUNAR_VERIFICATION_FULL=1 or RUNAR_VERIFICATION_REGEN=1")
  match shardSpec with
  | some (s, n) =>
      IO.println s!"PIPELINE GOLDEN: live cryptoAxiomPending shard {s}/{n}"
  | none => pure ()
  let mut total := 0
  let mut matched := 0
  let mut matchedNames : List String := []
  let mut fixtureNames : List String := []
  let mut fullShardSkipped : List String := []
  -- 3c: Per-fixture timing telemetry for the cryptoAxiomPending bucket.
  -- Each entry: (fixture name, milliseconds elapsed, byteExact?).
  let mut fullTimings : List (String × Nat × Bool) := []
  -- 2b: Track regen state per cryptoAxiomPending fixture.
  --   "stale"        — stored constant exists but diverges from live hex
  --   "unpopulated"  — no stored constant; first regen
  --   "fresh"        — live hex matches stored constant
  let mut regenStatus : List (String × String) := []
  let regenDir ←
    if regen then
      match (← IO.getEnv "RUNAR_VERIFICATION_REGEN_DIR") with
      | some dir => pure dir
      | none => pure "/tmp/runar-verification-regen"
    else
      pure ""
  if regen then
    IO.FS.createDirAll regenDir
  let mut regenOutputs : List (String × String) := []
  -- 2b: Track which cryptoAxiomPending fixtures matched via stored
  -- constant in default mode. Surfaces "constant set but stale vs.
  -- expected-script.hex" cases as a separate gate.
  let mut constMatched : List String := []
  let mut constUnpopulated : List String := []
  -- Finding #6: a populated crypto anchor whose stored constant DISAGREES
  -- with expected-script.hex (the golden). Previously the default-mode gate
  -- dropped these SILENTLY (no NOTICE, no failure), so a crypto byte anchor
  -- could go inert without anyone noticing. Now tracked + enforced below.
  let mut constStale : List String := []
  for e in entries do
    let path := e.path
    let ir := path / "expected-ir.json"
    let hex := path / "expected-script.hex"
    if (← System.FilePath.pathExists ir) && (← System.FilePath.pathExists hex) then
      try
        let irJson ← IO.FS.readFile ir.toString
        let expected := (← IO.FS.readFile hex.toString).trimAscii.toString
        match ANFProgram.fromString irJson with
        | .ok p =>
            total := total + 1
            fixtureNames := e.fileName :: fixtureNames
            let isCryptoPending := cryptoAxiomPending.contains e.fileName
            let inShard :=
              match shardSpec with
              | none => true
              | some (s, n) =>
                  if isCryptoPending then assignedToShard e.fileName s n
                  else true
            -- Phase 5: the EC / P-256 / P-384 / SLH-DSA fixtures in
            -- `cryptoAxiomPending` are skipped by default in live-compile
            -- mode (`compileHex` >25 min/fixture). Three gating modes:
            --
            -- * Default: compare the stored constant
            --   `cryptoAxiomPendingExpected` against `expected-script.hex`.
            --   Instant. Surfaces unpopulated constants as a NOTICE.
            -- * `RUNAR_VERIFICATION_REGEN=1`: live compileHex, compare
            --   against stored constant (catches stale constants when
            --   the lowering changes), dump live hex to stderr for
            --   offline copy-paste into `cryptoAxiomPendingExpected`.
            -- * `RUNAR_VERIFICATION_FULL=1`: live compileHex, compare
            --   against `expected-script.hex` directly (pre-existing).
            if isCryptoPending && !full && !regen then
              -- Default mode: gate via stored constant.
              match cryptoAxiomPendingExpected e.fileName with
              | some storedHex =>
                  if expected == storedHex then
                    matched := matched + 1
                    matchedNames := e.fileName :: matchedNames
                    constMatched := e.fileName :: constMatched
                  else
                    -- Finding #6: stored constant disagrees with the golden
                    -- (stale). No longer silently dropped — enforced below.
                    constStale := e.fileName :: constStale
              | none =>
                  constUnpopulated := e.fileName :: constUnpopulated
            else if isCryptoPending && !inShard then
              fullShardSkipped := e.fileName :: fullShardSkipped
            else
              -- 3c: Time each fixture's compile. In full mode, log
              -- per-fixture progress so users see what's happening
              -- during multi-hour runs.
              let t0 ← IO.monoMsNow
              match compileHexSafe p with
              | .error err =>
                  IO.eprintln s!"  COMPILE FAIL: {e.fileName}: {toString (repr err)}"
                  -- Baseline fixtures must compile. Pending fixtures (and any
                  -- not-yet-inventoried name) are allowed to fail compileHex;
                  -- they count as not byte-exact. Aborting here used to hide
                  -- the inventory mismatch for fixtures added after the
                  -- Phase-3 lock (`byte-builtins` and seven peers).
                  if baselineMatches.contains e.fileName then
                    IO.Process.exit 1
                  else
                    pure ()
              | .ok actual =>
                  let isMatch := expected == actual
                  let t1 ← IO.monoMsNow
                  let elapsedMs := t1 - t0
                  if (full || regen) && isCryptoPending then
                    fullTimings := (e.fileName, elapsedMs, isMatch) :: fullTimings
                    IO.eprintln s!"  [{if regen then "regen" else "full"}] {e.fileName} compiled in {elapsedMs}ms (byte-exact={isMatch})"
                    (← IO.getStderr).flush
                  if regen && isCryptoPending then
                    -- Compare live hex against stored constant.
                    let status :=
                      match cryptoAxiomPendingExpected e.fileName with
                      | some storedHex =>
                          if storedHex == actual then "fresh" else "stale"
                      | none => "unpopulated"
                    regenStatus := (e.fileName, status) :: regenStatus
                    regenOutputs := (e.fileName, actual) :: regenOutputs
                    -- Dump live hex to a file for offline review. Keeps
                    -- stderr human-readable while preserving the full
                    -- multi-MB hex per fixture.
                    let outFile := s!"{regenDir}/{e.fileName}.hex"
                    IO.FS.writeFile outFile actual
                    IO.eprintln s!"REGEN {e.fileName}: live hex written to {outFile} ({actual.length} chars)"
                    (← IO.getStderr).flush
                  if isMatch then
                    matched := matched + 1
                    matchedNames := e.fileName :: matchedNames
        | _ => pure ()
      catch _ => pure ()
  IO.println s!"PIPELINE GOLDEN: {matched}/{total} byte-exact"
  -- Finding #24: the model identity every stored crypto constant is measured
  -- against. Copy this value into `modelFingerprintAdopted` when re-attesting.
  IO.println s!"MODEL FINGERPRINT: {modelFingerprint}"

  -- Finding #24: exact, not "at least". The old lower bound had drifted to 49
  -- while 64 fixtures existed on disk, so it could never fire.
  if total != expectedFixtureTotal then
    IO.eprintln s!"FAIL: discovered {total} fixtures, expected exactly {expectedFixtureTotal}"
    IO.eprintln "  The fixture corpus and the bucket inventory in tests/PipelineGolden.lean have"
    IO.eprintln "  diverged. Add/remove the fixture in the bucket lists and update"
    IO.eprintln "  `expectedFixtureTotal` (a compile-time `example` pins it to trackedFixtures.length)."
    IO.Process.exit 1

  let duplicateTracked := findDuplicates trackedFixtures
  if !duplicateTracked.isEmpty then
    IO.eprintln "FAIL: fixture appears in more than one gate bucket:"
    for n in duplicateTracked do
      IO.eprintln s!"  - {n}"
    IO.Process.exit 1

  let missingTracked := missingFrom fixtureNames trackedFixtures
  let unknownTracked := missingFrom trackedFixtures fixtureNames
  if !missingTracked.isEmpty || !unknownTracked.isEmpty then
    if !missingTracked.isEmpty then
      IO.eprintln "FAIL: fixtures missing from PipelineGolden bucket inventory:"
      for n in missingTracked do
        IO.eprintln s!"  - {n}"
    if !unknownTracked.isEmpty then
      IO.eprintln "FAIL: bucket inventory names not present in conformance/tests:"
      for n in unknownTracked do
        IO.eprintln s!"  - {n}"
    IO.Process.exit 1

  for (bucket, names) in fixtureBuckets do
    if names.length > 0 then
      IO.println s!"  bucket {bucket}: {names.length}"

  -- Name demotions before the later gates abort, so a finding-#6 / fingerprint
  -- failure still tells you WHICH baseline fixtures no longer match.
  let mut demotedEarly : List String := []
  for n in baselineMatches do
    if !matchedNames.contains n then
      demotedEarly := n :: demotedEarly
  if !demotedEarly.isEmpty then
    IO.eprintln s!"NOTICE: {demotedEarly.length} baselineMatches fixture(s) NO LONGER byte-exact:"
    for n in demotedEarly.reverse do
      IO.eprintln s!"  - {n}"
  let mut promoEarly : List String := []
  for n in matchedNames do
    if !baselineMatches.contains n && !cryptoAxiomPending.contains n then
      promoEarly := n :: promoEarly
  if !promoEarly.isEmpty then
    IO.eprintln "NOTICE: byte-exact fixtures NOT in baselineMatches:"
    for n in promoEarly.reverse do
      IO.eprintln s!"  - {n}"

  if (full || regen) && !fullShardSkipped.isEmpty then
    IO.println "  live cryptoAxiomPending fixtures skipped by shard:"
    for n in fullShardSkipped.reverse do
      IO.println s!"    - {n}"
  -- 3c: Surface per-fixture timing for the cryptoAxiomPending bucket
  -- when full or regen mode ran.
  if (full || regen) && !fullTimings.isEmpty then
    IO.println ""
    IO.println s!"{if regen then "REGEN" else "FULL"}-MODE TIMING (cryptoAxiomPending bucket):"
    let sorted := fullTimings.reverse  -- preserve discovery order
    for (n, ms, m) in sorted do
      let mark := if m then "✓" else "✗"
      IO.println s!"  {mark} {n}: {ms}ms"
  -- 2b: In regen mode, surface stored-constant-vs-live divergence as a
  -- separate report. Stale constants fail the regen check; unpopulated
  -- ones are normal during initial regen.
  if regen && !regenStatus.isEmpty then
    let generated := s!"{regenDir}/cryptoAxiomPendingExpected.generated.lean"
    IO.FS.writeFile generated (cryptoExpectedSnippet modelFingerprint regenOutputs.reverse)
    IO.println s!"REGEN constants snippet: {generated}"
    IO.println ""
    IO.println "REGEN STATUS (stored constant vs. live compileHex):"
    let sorted := regenStatus.reverse
    let mut staleCount := 0
    for (n, status) in sorted do
      IO.println s!"  [{status}] {n}"
      if status == "stale" then
        staleCount := staleCount + 1
    if staleCount > 0 then
      IO.eprintln ""
      IO.eprintln s!"REGEN FAIL: {staleCount} stored constant(s) are stale."
      IO.eprintln "  Update tests/PipelineGolden.lean's cryptoAxiomPendingExpected"
      IO.eprintln "  with the live hex from the REGEN <name>: ... lines above."
      IO.Process.exit 1
  -- 2b: In default mode, surface cryptoAxiomPending fixtures whose
  -- stored constant is unpopulated. Non-fatal NOTICE — these are the
  -- candidates for the next offline regen.
  -- Finding #6: enforce the INERT crypto byte-anchor inventory in default
  -- mode. `constStale`/`constUnpopulated` are only populated when a crypto
  -- fixture went through the stored-constant path (i.e. default mode); in
  -- full/regen mode the crypto fixtures live-compile instead, so this gate is
  -- scoped to `!full && !regen`. The live inert set MUST exactly equal the
  -- declared `cryptoAnchorGaps` inventory — see that def's docstring.
  if !full && !regen then
    let inertAnchors := constUnpopulated ++ constStale
    if !inertAnchors.isEmpty then
      IO.eprintln s!"NOTICE: {inertAnchors.length} crypto byte anchor(s) INERT (tracked in cryptoAnchorGaps):"
      for n in constUnpopulated.reverse do
        IO.eprintln s!"  - {n} (unpopulated)"
      for n in constStale.reverse do
        IO.eprintln s!"  - {n} (stale: stored constant disagrees with golden)"
      IO.eprintln "  Populate via RUNAR_VERIFICATION_REGEN=1 offline compute — do NOT paste expected-script.hex."
    -- (a) a crypto anchor went inert without being declared: FAIL LOUD.
    let undeclaredInert := missingFrom inertAnchors cryptoAnchorGaps
    if !undeclaredInert.isEmpty then
      IO.eprintln "FAIL (finding #6): crypto byte anchor(s) went INERT but are NOT declared in cryptoAnchorGaps:"
      for n in undeclaredInert do
        IO.eprintln s!"  - {n}"
      IO.eprintln "  A previously-live crypto anchor is now unpopulated or stale. Investigate the"
      IO.eprintln "  codegen change and regenerate the constant LIVE (RUNAR_VERIFICATION_REGEN=1)."
      IO.eprintln "  Do NOT paste expected-script.hex. If this is a genuine new gap, add it to"
      IO.eprintln "  cryptoAnchorGaps with justification."
      IO.Process.exit 1
    -- (b) a declared gap is no longer inert (constant now matches the golden —
    -- possibly a paste): FAIL LOUD so the recovery is reviewed, not silent.
    let recoveredGaps := missingFrom cryptoAnchorGaps inertAnchors
    if !recoveredGaps.isEmpty then
      IO.eprintln "FAIL (finding #6): cryptoAnchorGaps lists fixture(s) that are no longer inert:"
      for n in recoveredGaps do
        IO.eprintln s!"  - {n}"
      IO.eprintln "  Their stored constant now matches the golden. Remove them from cryptoAnchorGaps"
      IO.eprintln "  in a reviewed change — and confirm via RUNAR_VERIFICATION_REGEN=1 that the"
      IO.eprintln "  constant was regenerated LIVE (not pasted) before trusting the anchor."
      IO.Process.exit 1
    -- Finding #24: stored-constant PROVENANCE gate. The inventory above proves a
    -- constant still byte-equals the golden; it says nothing about WHICH Lean
    -- model produced the constant. A constant derived under an older model can
    -- keep matching while the current model would emit something else — that is
    -- the "stale constant masquerades as verified" failure. Scoped to default
    -- mode for the same reason as the inventory gate: only default mode gates
    -- through the stored constants (full/regen live-compile instead, and regen
    -- is the tool used to REPAIR provenance, so it must not be blocked by it).
    let provNames := cryptoAxiomPendingProvenance.map (·.fixture)
    let provDupes := findDuplicates provNames
    let provMissing := missingFrom cryptoAxiomPending provNames
    let provExtra := missingFrom provNames cryptoAxiomPending
    if !provDupes.isEmpty || !provMissing.isEmpty || !provExtra.isEmpty then
      IO.eprintln "FAIL (finding #24): cryptoAxiomPendingProvenance does not cover cryptoAxiomPending exactly:"
      for n in provDupes do
        IO.eprintln s!"  - {n} (duplicate provenance entry)"
      for n in provMissing do
        IO.eprintln s!"  - {n} (crypto anchor with NO provenance entry)"
      for n in provExtra do
        IO.eprintln s!"  - {n} (provenance entry for a fixture that is not a crypto anchor)"
      IO.eprintln "  Every stored constant must carry a provenance record — see AnchorProvenance."
      IO.Process.exit 1
    -- (a) `.inert` must mean exactly "declared in cryptoAnchorGaps", which the
    -- gate above has already reconciled with the LIVE inert set. Without this a
    -- drifted anchor could be parked at `.inert` to dodge the fingerprint check.
    let mut originMismatch : List String := []
    for p in cryptoAxiomPendingProvenance do
      if (p.origin == AnchorOrigin.inert) != cryptoAnchorGaps.contains p.fixture then
        originMismatch := p.fixture :: originMismatch
    if !originMismatch.isEmpty then
      IO.eprintln "FAIL (finding #24): provenance origin disagrees with the cryptoAnchorGaps inventory:"
      for n in originMismatch.reverse do
        let inGaps := cryptoAnchorGaps.contains n
        IO.eprintln s!"  - {n} ({if inGaps then "listed in cryptoAnchorGaps but provenance is not .inert" else "provenance says .inert but it is not a declared gap"})"
      IO.Process.exit 1
    -- (b) THE gate: a live anchor must have been established under the model
    -- that is on disk right now.
    let mut driftedProvenance : List (String × String) := []
    for p in cryptoAxiomPendingProvenance do
      if p.origin != AnchorOrigin.inert && p.modelFingerprint != modelFingerprint then
        driftedProvenance := (p.fixture, p.modelFingerprint) :: driftedProvenance
    if !driftedProvenance.isEmpty then
      IO.eprintln ""
      IO.eprintln s!"FAIL (finding #24): {driftedProvenance.length} stored crypto byte anchor(s) were derived from a DIFFERENT Lean model:"
      IO.eprintln s!"  model on disk : {modelFingerprint}"
      for (n, fp) in driftedProvenance.reverse do
        IO.eprintln s!"  - {n}: recorded {fp}"
      IO.eprintln "  These constants are no longer evidence: the model changed under them, so"
      IO.eprintln "  matching expected-script.hex proves nothing about the CURRENT pipeline."
      IO.eprintln "  Fix by ONE of:"
      IO.eprintln "    1. re-derive (adds evidence) — RUNAR_VERIFICATION_REGEN=1 lake env"
      IO.eprintln "       ./.lake/build/bin/pipelineGolden, then paste the generated constants +"
      IO.eprintln "       provenance rows (origin .regenLive) from the regen directory; or"
      IO.eprintln "    2. re-attest (adds NO evidence, must be reviewed) — set"
      IO.eprintln s!"       `def modelFingerprintAdopted : String := \"{modelFingerprint}\"`"
      IO.eprintln "       and justify why the model change cannot have moved these fixtures' hex."
      IO.eprintln "  Do NOT paste expected-script.hex into cryptoAxiomPendingExpected."
      IO.Process.exit 1
    -- (c) evidence tiers are reported on every run: an `.inherited` anchor
    -- passes the gate but has never been re-derived live at its fingerprint.
    let liveAnchors := cryptoAxiomPendingProvenance.filter (fun p => p.origin != AnchorOrigin.inert)
    let regenLiveAnchors := liveAnchors.filter (fun p => p.origin == AnchorOrigin.regenLive)
    let inheritedAnchors := liveAnchors.filter (fun p => p.origin == AnchorOrigin.inherited)
    IO.println s!"  crypto byte anchors: {regenLiveAnchors.length} regen-live, {inheritedAnchors.length} inherited, {cryptoAxiomPendingProvenance.length - liveAnchors.length} inert"
    if !inheritedAnchors.isEmpty then
      IO.eprintln s!"NOTICE (finding #24): {inheritedAnchors.length} live crypto byte anchor(s) rest on INHERITED provenance:"
      for p in inheritedAnchors do
        IO.eprintln s!"  - {p.fixture}"
      IO.eprintln "  They match the golden and carry the current model fingerprint, but no live"
      IO.eprintln "  RUNAR_VERIFICATION_REGEN=1 run has re-derived them, so nothing confirms the"
      IO.eprintln "  CURRENT model produces them. See cryptoAxiomPendingProvenance for why each is"
      IO.eprintln "  still inherited, and promote to .regenLive once a live regen succeeds."
  -- Phase 4 diagnostic: surface any matched fixture that is neither in
  -- baselineMatches nor covered by stored crypto constants.
  let mut promoCandidates : List String := []
  for n in matchedNames do
    if !baselineMatches.contains n && !cryptoAxiomPending.contains n then
      promoCandidates := n :: promoCandidates
  if !promoCandidates.isEmpty then
    IO.eprintln "NOTICE: byte-exact fixtures NOT in baselineMatches:"
    for n in promoCandidates do
      IO.eprintln s!"  - {n}"

  -- Phase 4 diagnostic (added 2026-08-23): the mirror of `promoCandidates`.
  -- Gate 1 below reports only that the COUNT regressed, which leaves the
  -- reader to find the fixture by hand. Name the demotions instead: a fixture
  -- listed in `baselineMatches` that is no longer byte-exact is exactly what a
  -- model change breaks, and it is the first thing anyone debugging the gate
  -- needs.
  let mut demoted : List String := []
  for n in baselineMatches do
    if !matchedNames.contains n then
      demoted := n :: demoted
  if !demoted.isEmpty then
    IO.eprintln s!"NOTICE: {demoted.length} baselineMatches fixture(s) NO LONGER byte-exact:"
    for n in demoted do
      IO.eprintln s!"  - {n}"

  -- Gate 1: total byte-exact count must not regress below the current gate.
  if matched < expectedByteExact then
    IO.eprintln s!"FAIL: byte-exact match regressed: {matched} < {expectedByteExact}"
    IO.Process.exit 1

  -- Gate 1b (finding #24): in default mode the byte-exact count is fully
  -- determined by the bucket inventory (baseline + non-inert crypto anchors), so
  -- it is checked for EQUALITY. An increase is drift too — a fixture became
  -- byte-exact, or an anchor came back to life, without the counts being
  -- rebaselined — and under a lower-bound-only gate that would pass silently.
  -- Live modes have their own gates (2b) and legitimately exceed this count.
  if !full && !regen && matched != expectedByteExact then
    IO.eprintln s!"FAIL (finding #24): byte-exact count drifted: {matched} != expectedByteExact ({expectedByteExact})"
    IO.eprintln "  Default mode verifies exactly `baselineMatches` + the crypto anchors not"
    IO.eprintln "  declared inert in `cryptoAnchorGaps`. Promote the newly byte-exact fixture(s)"
    IO.eprintln "  into the right bucket and rebaseline `expectedByteExact` in the same change"
    IO.eprintln "  (the compile-time `example` pins the two together)."
    IO.Process.exit 1

  -- Gate 2: every fixture from the Phase 3 baseline must still match. This
  -- guards against a swap (e.g. a new fixture becomes byte-exact while one
  -- of the original baseline silently breaks, leaving the count unchanged).
  let mut regressions : List String := []
  for name in baselineMatches do
    if !(matchedNames.contains name) then
      regressions := name :: regressions
  if !regressions.isEmpty then
    IO.eprintln "FAIL: previously byte-exact fixtures regressed:"
    for n in regressions.reverse do
      IO.eprintln s!"  - {n}"
    IO.Process.exit 1

  -- Gate 2b: unsharded full mode is the scheduled/manual "all fixtures"
  -- byte-exact gate. Sharded full mode gates exactly the assigned
  -- cryptoAxiomPending slice while still running the baseline regression
  -- gate above.
  if full then
    match shardSpec with
    | none =>
        -- Full mode: every discovered fixture EXCEPT the documented
        -- `lowerDivergencePending` divergences must be byte-exact.
        let expectedFullMatch := total - lowerDivergencePending.length
        if matched != expectedFullMatch then
          IO.eprintln s!"FAIL: full mode requires {expectedFullMatch} of {total} fixtures byte-exact (all but {lowerDivergencePending.length} documented divergences), got {matched}"
          IO.Process.exit 1
    | some (s, n) =>
        let mut shardMisses : List String := []
        for name in cryptoAxiomPending do
          if assignedToShard name s n && !(matchedNames.contains name) then
            shardMisses := name :: shardMisses
        if !shardMisses.isEmpty then
          IO.eprintln s!"FAIL: full shard {s}/{n} cryptoAxiomPending fixture(s) were not byte-exact:"
          for name in shardMisses.reverse do
            IO.eprintln s!"  - {name}"
          IO.Process.exit 1

  -- Gate 3: any fixture in the non-crypto pending-triage buckets that has
  -- flipped to byte-exact should be promoted into `baselineMatches`.
  -- Crypto fixtures are already gated by stored Lean-produced constants.
  let mut newlyMatched : List String := []
  for name in goOnlyFixtures ++ mathBuiltinsPending ++ lowerDivergencePending do
    if matchedNames.contains name then
      newlyMatched := name :: newlyMatched
  if !newlyMatched.isEmpty then
    IO.eprintln "NOTICE: fixtures in the pending-triage buckets are now byte-exact:"
    for n in newlyMatched.reverse do
      IO.eprintln s!"  - {n}"
    IO.eprintln "Promote them into `baselineMatches`."

  IO.println s!"OK: {expectedByteExact} fixtures byte-exact"
